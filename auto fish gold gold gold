local tabButtons = {}
local tabPages = {}

local function createTab(name, index)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -10, 0, 30)
    btn.Position = UDim2.new(0, 5, 0, 5 + ((index - 1) * 35))
    btn.BackgroundColor3 = index == 1 and Color3.fromRGB(25, 22, 40) or Color3.fromRGB(0, 0, 0)
    btn.BackgroundTransparency = index == 1 and 0 or 1
    btn.Text = name
    btn.TextColor3 = index == 1 and Color3.fromRGB(255, 215, 0) or Color3.fromRGB(150, 150, 160)
    btn.TextSize = 11
    btn.Font = Enum.Font.GothamBold
    btn.Parent = Sidebar
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = btn
    
    local page = Instance.new("Frame")
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.Visible = (index == 1)
    page.Parent = Container
    
    tabButtons[name] = btn
    tabPages[name] = page
    
    btn.MouseButton1Click:Connect(function()
        for tName, tBtn in pairs(tabButtons) do
            tBtn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            tBtn.BackgroundTransparency = 1
            tBtn.TextColor3 = Color3.fromRGB(150, 150, 160)
        end
        for tName, tPage in pairs(tabPages) do
            tPage.Visible = false
        end
        btn.BackgroundColor3 = Color3.fromRGB(25, 22, 40)
        btn.BackgroundTransparency = 0
        btn.TextColor3 = Color3.fromRGB(255, 215, 0)
        page.Visible = true
    end)
    return page
end

