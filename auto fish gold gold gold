-- =============================================================================
-- 3. SPEED-OPTIMIZED PATHING LOGIC
-- =============================================================================
local function updateStatus(text, isWarning)
    if not GoldFishFarmGUI or not StatusLabel.Parent then return end
    StatusLabel.Text = "STATUS: " .. string.upper(text)
    StatusLabel.TextColor3 = isWarning and Color3.fromRGB(255, 90, 90) or Color3.fromRGB(200, 205, 225)
end

local function tp(targetPosition)
    local character = player.Character or player.CharacterAdded:Wait()
    local rootPart = character:WaitForChild("HumanoidRootPart", 5)
    if rootPart then
        rootPart.CFrame = CFrame.new(targetPosition)
        return true
    end
    return false
end

local function flyWalkTo(targetPosition)
    local character = player.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end
    
    local startPos = rootPart.Position
    local distance = (targetPosition - startPos).Magnitude
    local startTime = tick()
    
    while isLooping do
        local travelTime = distance / config.GlideSpeed
        local elapsed = tick() - startTime
        local progress = math.min(elapsed / travelTime, 1)
        rootPart.CFrame = CFrame.new(startPos:Lerp(targetPosition, progress))
        if progress >= 1 then break end
        task.wait()
    end
    
    if isLooping then
        rootPart.CFrame = CFrame.new(targetPosition)
        return true
    end
    return false
end

local function checkInstantStill()
    local character = player.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end
    
    local p1 = rootPart.Position
    task.wait(0.05)
    
    character = player.Character
    rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end
    
    local p2 = rootPart.Position
    return (p1 - p2).Magnitude < 0.05
end

local function runVelocityLoop()
    while isLooping do
        updateStatus("Collecting loot...")
        local reachedSafe = tp(posSafeSpace)
        if not reachedSafe then
            task.wait(0.5)
            continue
        end
        task.wait(config.CollectionTime)
        
        if not isLooping then break end

        updateStatus("Stabilizing physics...")
        tp(posSafeSpace)
        task.wait(config.AlignTime)
        
        if not isLooping then break end

        updateStatus("Walking to path cords...")
        local reachedTargetPath = flyWalkTo(posWalkTarget)
        if not reachedTargetPath then continue end
        
        if not isLooping then break end

        updateStatus("Walking back to base...")
        local returnedToSafe = flyWalkTo(posSafeSpace)
        if not returnedToSafe then continue end
        
        if not isLooping then break end

        updateStatus("Firing fishing trigger...")
        local movedToGrounds = tp(posGoodZone)
        if not movedToGrounds then continue end
        
        updateStatus("Awaiting freeze...")
        local freezeTimer = 0
        local safetyTimeout = 0
        
        while isLooping and safetyTimeout < 15 do
            if checkInstantStill() then
                freezeTimer = freezeTimer + 0.05
                updateStatus(string.format("Freezing... (%.1fs)", freezeTimer))
                if freezeTimer >= FREEZE_THRESHOLD then
                    break
                end
            else
                freezeTimer = 0 
            end
            task.wait(0.05)
            safetyTimeout = safetyTimeout + 0.05
        end
        
        if not isLooping then break end
        
        updateStatus("Processing payload...")
        while isLooping do
            if not checkInstantStill() then
                break 
            end
            task.wait(0.05)
        end
        
        if not isLooping then break end
    end
    
    if GoldFishFarmGUI.Parent then
        updateStatus("IDLE")
    end
end

-- =============================================================================
-- 4. TOGGLE COMPONENT SLIDING INTERACTION SYSTEM
-- =============================================================================
ToggleTrack.MouseButton1Click:Connect(function()
    isLooping = not isLooping
    
    local ballTargetPosition
    local trackTargetColor
    
    if isLooping then
        ToggleText.Text = "STOP AUTO FISH"
        ballTargetPosition = UDim2.new(0, 30, 0, 3) -- Slide right side
        trackTargetColor = Color3.fromRGB(186, 114, 255) -- Matching the lavender purple light state from your reference image cfe742.png
        
        task.spawn(runVelocityLoop)
    else
        ToggleText.Text = "START AUTO FISH"
        ballTargetPosition = UDim2.new(0, 3, 0, 3) -- Slide back left
        trackTargetColor = Color3.fromRGB(40, 35, 55) -- Return to default track off color
        
        updateStatus("Stopping...")
    end
    
    -- Animate the sliding ball and track color transitions smoothly
    TweenService:Create(ToggleBall, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = ballTargetPosition}):Play()
    TweenService:Create(ToggleTrack, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = trackTargetColor}):Play()
end)

